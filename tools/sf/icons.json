{
  "_comment": "selector -> SF Symbol. box = size of the drawn mask in px; the symbol fills ~57% of it. anchor:left draws into the menu icon column instead of over Discord's icon.",
  "groups": [
    {
      "box": 25,
      "anchor": "left",
      "scope": ":is(#message, #message-actions, #channel-context, #guild-context, #user-context, #guild-header-popout) {item}",
      "items": {
        "#message-add-reaction": "face.smiling",
        "#message-reply": "arrowshape.turn.up.left",
        "#message-forward": "arrowshape.turn.up.right",
        "#message-thread": "bubble.left.and.text.bubble.right",
        "#message-copy-text": "doc.on.doc",
        "#message-pin": "pin",
        "#message-unpin": "pin.slash",
        "#message-bookmark": "bookmark",
        "#message-reminder": "clock",
        "#message-apps": "square.grid.2x2",
        "#message-mark-unread": "envelope.badge",
        "#message-copy-link": "link",
        "#message-edit": "pencil",
        "[id^=\"message-tts\"]": "speaker.wave.2",
        "#message-delete": "trash",
        "#message-report": "flag",
        "[id*=\"-devmode-copy-id\"]": "number",
        "#channel-context-mark-channel-read": "envelope.open",
        "#channel-context-favorite-channel": "star",
        "#channel-context-invite-people": "person.badge.plus",
        "#channel-context-pin-channel": "pin",
        "#channel-context-channel-copy-link": "link",
        "#channel-context-mute-channel": "bell.slash",
        "#channel-context-channel-notifications": "bell",
        "#channel-context-move-to": "folder",
        "#channel-context-edit-channel": "gearshape",
        "#channel-context-clone-channel": "plus.square.on.square",
        "#channel-context-create-text-channel": "plus",
        "#channel-context-delete-channel": "trash",
        "#guild-context-mark-guild-read": "envelope.open",
        "#guild-context-invite-people": "person.badge.plus",
        "#guild-context-mute-guild": "bell.slash",
        "#guild-context-guild-notifications": "bell",
        "#guild-context-hide-muted-channels": "eye.slash",
        "#guild-context-guild-settings": "gearshape",
        "#guild-context-privacy": "hand.raised",
        "#guild-context-change-nickname": "pencil",
        "#guild-context-create-event": "calendar.badge.plus",
        "#guild-context-move-to": "folder",
        "#guild-context-leave-guild": "rectangle.portrait.and.arrow.right",
        "#user-context-user-profile": "person.crop.circle",
        "#user-context-mention": "at",
        "#user-context-message-user": "message",
        "#user-context-call": "phone",
        "#user-context-note": "note.text",
        "#user-context-add-friend-nickname": "pencil",
        "#user-context-change-nickname": "pencil",
        "#user-context-apps": "square.grid.2x2",
        "#user-context-invite-to-server": "person.badge.plus",
        "#user-context-remove-friend": "person.badge.minus",
        "#user-context-ignore": "eye.slash",
        "#user-context-block": "nosign",
        "#user-context-roles": "tag",
        "#user-context-mod-view": "shield",
        "#user-context-verify": "checkmark.seal",
        "#user-context-timeout": "timer",
        "#user-context-kick": "rectangle.portrait.and.arrow.right",
        "#user-context-ban": "hammer",
        "#guild-header-popout-premium-subscribe": "sparkles",
        "#guild-header-popout-guild-tag": "tag",
        "#guild-header-popout-invite-people": "person.badge.plus",
        "#guild-header-popout-settings": "gearshape",
        "#guild-header-popout-insights": "chart.bar",
        "#guild-header-popout-create-channel": "plus.circle",
        "#guild-header-popout-create-category": "folder.badge.plus",
        "#guild-header-popout-create-event": "calendar.badge.plus",
        "#guild-header-popout-active-threads": "bubble.left.and.text.bubble.right",
        "#guild-header-popout-application-directory": "square.grid.2x2",
        "#guild-header-popout-opt-in": "list.bullet",
        "#guild-header-popout-notifications": "bell",
        "#guild-header-popout-privacy": "hand.raised",
        "#guild-header-popout-change-nickname": "pencil",
        "#guild-header-popout-hide-muted-channels": "eye.slash",
        "#guild-header-popout-server-lockdown": "lock",
        "#guild-header-popout-report-raid": "exclamationmark.shield",
        "#message-actions-add-reaction": "face.smiling",
        "#message-actions-reply": "arrowshape.turn.up.left",
        "#message-actions-forward": "arrowshape.turn.up.right",
        "#message-actions-thread": "bubble.left.and.text.bubble.right",
        "#message-actions-copy-text": "doc.on.doc",
        "#message-actions-pin": "pin",
        "#message-actions-unpin": "pin.slash",
        "#message-actions-bookmark": "bookmark",
        "#message-actions-reminder": "clock",
        "#message-actions-apps": "square.grid.2x2",
        "#message-actions-mark-unread": "envelope.badge",
        "#message-actions-copy-link": "link",
        "#message-actions-edit": "pencil",
        "#message-actions-delete": "trash",
        "#message-actions-report": "flag",
        "#message-view-reactions": "eye",
        "#message-actions-view-reactions": "eye",
        "#message-remove-reactions": "face.dashed",
        "#message-actions-remove-reactions": "face.dashed",
        "#message-remove-all-reactions": "xmark.circle",
        "#message-actions-remove-all-reactions": "xmark.circle"
      }
    },
    {
      "box": 25,
      "scope": "[role=\"menu\"] {item} [class*=\"iconContainerLeft_\"]",
      "items": {
        "#audio-device-context-voice-settings": "gearshape",
        "[id*=\"-devmode-copy-id\"]": "number"
      }
    },
    {
      "box": 27,
      "scope": "{item}",
      "items": {
        "[class*=\"toolbar_\"] [aria-label=\"Threads\"]": "bubble.left.and.text.bubble.right",
        "[class*=\"toolbar_\"] [aria-label=\"Notification Settings\"]:not(:has(path[d^=\"M1.3 21.3\"]))": "bell",
        "[class*=\"toolbar_\"] [aria-label=\"Notification Settings\"]:has(path[d^=\"M1.3 21.3\"])": "bell.slash",
        "[class*=\"toolbar_\"] [aria-label=\"Pinned Messages\"]": "pin",
        "[class*=\"toolbar_\"] [aria-label=\"Hide Member List\"]": "person.2.fill",
        "[class*=\"toolbar_\"] [aria-label=\"Show Member List\"]": "person.2",
        "[class*=\"toolbar_\"] [aria-label=\"Hide User Profile\"]": "person.crop.circle.fill",
        "[class*=\"toolbar_\"] [aria-label=\"Show User Profile\"]": "person.crop.circle",
        "[class*=\"toolbar_\"] [aria-label=\"New Group DM\"]": "plus.bubble"
      }
    },
    {
      "box": 30,
      "scope": "{item}",
      "items": {
        "form [aria-label=\"More message options\"]": "plus",
        "form [aria-label=\"Send a gift\"]": "gift",
        "form [aria-label=\"Open sticker picker\"]": "rectangle.portrait.on.rectangle.portrait.angled",
        "form [aria-label=\"Add Emoji\"]": "face.smiling",
        "form [aria-label=\"Apps\"]": "square.grid.2x2",
        "[class*=\"panels_\"] button[aria-label=\"Mute\"]:not([class*=\"plateMuted_\"])": "mic",
        "[class*=\"panels_\"] button[aria-label=\"Mute\"][class*=\"plateMuted_\"], [class*=\"panels_\"] button[aria-label=\"Unmute\"]": "mic.slash",
        "[class*=\"panels_\"] button[aria-label=\"Deafen\"]:not([class*=\"plateMuted_\"])": "headphones",
        "[class*=\"panels_\"] button[aria-label=\"Deafen\"][class*=\"plateMuted_\"], [class*=\"panels_\"] button[aria-label=\"Undeafen\"]": "headphones.slash",
        "[class*=\"panels_\"] button[aria-label=\"User Settings\"]": "gearshape",
        "[class*=\"buttonContainer_\"] [aria-label=\"Add Reaction\"]": "face.smiling",
        "[class*=\"buttonContainer_\"] [aria-label=\"Reply\"]": "arrowshape.turn.up.left",
        "[class*=\"buttonContainer_\"] [aria-label=\"Forward\"]": "arrowshape.turn.up.right",
        "[class*=\"buttonContainer_\"] [aria-label=\"Create Thread\"]": "bubble.left.and.text.bubble.right",
        "[class*=\"buttonContainer_\"] [aria-label=\"Edit\"]": "pencil",
        "[class*=\"buttonContainer_\"] [aria-label=\"More\"]": "ellipsis"
      }
    },
    {
      "box": 26,
      "scope": "[class*=\"base_\"] > [class*=\"bar_\"] {item}",
      "items": {
        "[aria-label=\"Go back\"]": "chevron.left",
        "[aria-label=\"Go forward\"]": "chevron.right",
        "[aria-label=\"Inbox\"]": "tray",
        "[aria-label=\"Help\"]": "questionmark.circle"
      }
    },
    {
      "box": 25,
      "anchor": "left",
      "x": "19px",
      "hide": "> svg[class*=\"itemIcon_\"]",
      "scope": "[class*=\"layer_\"] [role=\"listbox\"] [role=\"option\"] > [class*=\"item_\"]{item}",
      "items": {
        ":has(> svg path[d^=\"M12 10a4 4\"])": "person",
        ":has(> svg path[d^=\"M10.99 3.16A1\"])": "number",
        ":has(> svg path[d^=\"M10.57 4.01a6.97\"])": "paperclip",
        ":has(> svg path[d^=\"M16.44 6.96c\"])": "at",
        ":has(> svg path[d^=\"M22 5a1 1 0 0 1-1 1h-8\"])": "slider.horizontal.3",
        ":has(> svg path[d^=\"M15.62 17.03a9\"])": "magnifyingglass"
      }
    },
    {
      "box": 24,
      "scope": "[class*=\"layer_\"] [role=\"listbox\"] {item}",
      "items": {
        "[class*=\"clearSearchHistory_\"]": "trash"
      }
    }
  ]
}
